# ChatECNU configuration. The base URL and exact model IDs must be confirmed.
# Web users enter their own key in Settings; it stays in browser localStorage.
# Keep this field empty for the workbench. CLI-only runs may configure a key locally.
CHATECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
CHATECNU_MODEL=ecnu-max
CHATECNU_VISION_MODEL=ecnu-plus
CHATECNU_API_KEY=
# Set only after the user has authorized a call limit/cost boundary.
CHATECNU_MAX_CALLS=0
CHATECNU_MAX_OUTPUT_TOKENS=512

# Exact installed game version; do not infer from the Wiki page date.
SDV_GAME_VERSION=
SDV_PLATFORM=
SDV_MODDED=
